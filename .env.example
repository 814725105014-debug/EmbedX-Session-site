# EMBEDX INTERACTIVE - Environment Configuration
# Mentimeter-Inspired Live Engagement Platform
# SRM TRP Engineering College - Department of EEE

# Server Configuration
PORT=3001
NODE_ENV=development

# Optional Supabase Integration (Leave blank to use embedded real-time engine)
# When provided, the app will automatically synchronize presentations and sessions with Supabase Cloud.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Club & Institution Metadata
VITE_CLUB_NAME="EMBEDX - Embedded Systems & Automation Club"
VITE_INSTITUTION="Department of EEE, SRM TRP Engineering College"
VITE_CLUB_URL="https://embedx.neocities.org/"
